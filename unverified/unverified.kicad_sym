	(symbol "GRM21BR71E105KA99L" (pin_names hide) (in_bom yes) (on_board yes)
		(property "Reference" "C" (at 5.08 1.27 0) (effects (font (size 1.27 1.27))))
		(property "Value" "1uF" (at 5.08 -1.27 0) (effects (font (size 1.27 1.27))))
		(property "Footprint" "verified:C_0805_2012Metric" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
		(property "Datasheet" "https://search.murata.co.jp/Ceramy/image/img/A01X/G101/ENG/GRM21BR71E105KA99-01.pdf" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
		(property "Description" "1uF +/-10%, DC25V X7R MLCC, 0805" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
		(property "Manufacturer 1" "Murata" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
		(property "Manufacturer Part Number 1" "GRM21BR71E105KA99L" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
