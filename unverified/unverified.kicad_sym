				)
				(hide yes)
			)
		)
		(property "Power Rating Conditions" "Rated at 70°C ambient; full power from -55°C to 70°C, then linear derating to zero at 175°C. The rated dissipation applies only if the permitted 175°C film temperature is not exceeded."
			(at 0 0 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
		(property "Temperature Coefficient" "±25 ppm/°C"
			(at 0 0 0)
			(effects
